{
  "name": "wifi-lan",
  "version": "1.0.0",
  "private": true,
  "description": "Three-laptop userspace overlay for isolated guest Wi-Fi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "relay": "tsx src/cli.ts relay",
    "join": "tsx src/cli.ts join",
